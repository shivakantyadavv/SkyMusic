{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skymusic",
  "mainBinaryName": "skymusic",
  "version": "2.3.0",
  "identifier": "com.skymusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skymusic",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNjQ4QjI4OTJCQkI2MzcKUldRM3RydVNLSXRrUXduUkdoOWlsaGpseW0vaFlKTVY3dHR6RXYvTS9Mc3V4MHl1ZUdJYlN5c2sK",
      "endpoints": [
        "https://github.com/shivakantyadavv/skymusic/releases/latest/download/latest.json"
      ]
    }
  }
}
