rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - uid: string (required, immutable, == document {uid}, 1..128 chars)
//   - email: string | null (optional, <= 320 chars, valid email if non-empty)
//   - displayName: string | null (optional, <= 100 chars)
//   - activeRoomId: string (required, 1..128 chars)
//   - updatedAt: number (required, >= 0)
//
// Collection: syncRooms
// Document ID: {roomId} (1..128 chars)
// Fields:
//   - ownerUid: string (required, immutable, 1..128 chars)
//   - memberUids: list<string> (required, 1..10 UID strings of 1..128 chars; mutable only by ownerUid, ownerUid must remain a member)
//   - updatedAt: number (required, >= 0)
//   - snapshot: map (required)
//     - version: int (required, == 1)
//     - updatedAt: number (required, >= 0)
//     - updatedByDeviceId: string (required, <= 128 chars)
//     - updatedByDeviceName: string (required, <= 128 chars)
//     - likedTracks: list (required, <= 500 items)
//     - likedTrackAddedAt: map (required, <= 600 keys)
//     - deletedLikedAt: map (required, <= 500 keys)
//     - playlists: list (required, <= 100 items)
//     - playlistUpdatedAt: map (required, <= 150 keys)
//     - deletedPlaylistsAt: map (required, <= 500 keys)
//     - recentlyPlayed: list (required, <= 25 items)
//     - recentlyPlayedAt: map (required, <= 50 keys)
//     - preferences: map (required: theme in ['dark', 'light', 'glass'], atmosPreset in ['music', 'movie', 'bass', 'off'], updatedAt: number >= 0)
//     - continueListening: map | null (required key; if map: track, position, duration, isPlaying, deviceId, deviceName, updatedAt)
//
// Subcollection: syncRooms/{roomId}/devices
// Document ID: {deviceId} (1..128 chars)
// Fields:
//   - deviceId: string (required, == document {deviceId}, 1..128 chars)
//   - deviceName: string (required, <= 128 chars)
//   - platform: string (required, in ['desktop', 'tv', 'mobile'])
//   - appVersion: string (required, <= 64 chars)
//   - ownerUid: string (required, 1..128 chars, must be in parent room memberUids)
//   - nowPlaying: map | null (optional: title, artist, artwork?, trackId?, isPlaying, position, duration)
//   - lastSeenAt: number (required, >= 0)
//
// Subcollection: syncRooms/{roomId}/commands
// Document ID: {cmdId}
// Immutable after creation (updates disallowed).
// Fields:
//   - targetDeviceId: string (required, 1..128 chars)
//   - action: string (required, in ['play_track', 'play', 'pause', 'toggle', 'next', 'prev', 'seek', 'set_volume', 'set_atmos', 'sync_now'])
//   - fromDeviceId: string (required, 1..128 chars)
//   - fromDeviceName: string (required, <= 128 chars)
//   - track: map | null (optional)
//   - queue: list | null (optional, <= 100 items)
//   - position: number | null (optional, >= 0)
//   - volume: number | null (optional, 0..100)
//   - muted: bool | null (optional)
//   - atmosPreset: string | null (optional, in ['music', 'movie', 'bass', 'off'])
//   - timestamp: number (required, >= 0)
//
// Collection: tvPairCodes
// Document ID: {code} (6 numeric digits: ^[0-9]{6}$)
// List queries are explicitly denied to prevent brute-force enumeration.
// Fields:
//   - code: string (required, immutable, == document {code}, matches ^[0-9]{6}$)
//   - tvUid: string (required, immutable, == request.auth.uid on create, 1..128 chars)
//   - tvDeviceId: string (required, immutable, 1..128 chars)
//   - tvDeviceName: string (required, immutable, <= 128 chars)
//   - status: string (required, 'waiting' on create -> 'linked' on update)
//   - roomId: string | null (required key: null on create, 1..128 chars on update)
//   - linkedByUid: string | null (required key: null on create, == request.auth.uid on update)
//   - linkedByEmail: string | null (optional, <= 320 chars)
//   - linkedAt: number | null (optional, >= 0)
//   - createdAt: number (required, immutable, >= 0)
//   - expiresAt: number (required, immutable, > createdAt)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions (shallow to stay well within Firestore runtime limits)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function isRoomMember(roomId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/syncRooms/$(roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/syncRooms/$(roomId)).data.memberUids;
    }

    // ===============================================================
    // Domain Validators (leaf checks inlined to minimize call depth/budget)
    // ===============================================================

    function isValidTrack(t) {
      return t is map &&
        t.keys().hasAll(['id', 'title', 'artist', 'source']) &&
        t.keys().hasOnly([
          'id', 'title', 'artist', 'album', 'albumArt', 'duration',
          'streamUrl', 'source', 'externalUrl', 'artistId', 'albumId',
          'localPath', 'fileName', 'downloadedAt', 'quality', 'ytVideoId'
        ]) &&
        t.id is string && t.id.size() > 0 && t.id.size() <= 512 &&
        t.title is string && t.title.size() <= 500 &&
        t.artist is string && t.artist.size() <= 500 &&
        t.source is string && t.source in ['deezer', 'itunes', 'local', 'downloaded'] &&
        (!('album' in t) || t.album == null || (t.album is string && t.album.size() <= 500)) &&
        (!('albumArt' in t) || t.albumArt == null || (t.albumArt is string && t.albumArt.size() <= 32768)) &&
        (!('duration' in t) || t.duration == null || (t.duration is number && t.duration >= 0)) &&
        (!('streamUrl' in t) || t.streamUrl == null || (t.streamUrl is string && t.streamUrl.size() <= 4096)) &&
        (!('quality' in t) || t.quality == null || (
          t.quality is map &&
          t.quality.size() <= 7 &&
          t.quality.keys().hasOnly([
            'badge', 'detail', 'codec', 'bitrateKbps',
            'sampleRateHz', 'bitDepth', 'tier'
          ])
        ));
    }

    function isValidUser(data, uid) {
      return data is map &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'activeRoomId', 'updatedAt']) &&
        data.keys().hasAll(['uid', 'activeRoomId', 'updatedAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.uid == uid &&
        (!('email' in data) || data.email == null || (
          data.email is string &&
          data.email.size() <= 320 &&
          (data.email.size() == 0 || data.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"))
        )) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
        data.activeRoomId is string && data.activeRoomId.size() > 0 && data.activeRoomId.size() <= 128 &&
        data.updatedAt is number && data.updatedAt >= 0;
    }

    function isValidSyncRoom(data, roomId) {
      let m = data.memberUids;
      let s = data.snapshot;
      let p = s.preferences;
      let cl = s.continueListening;
      return roomId is string && roomId.size() > 0 && roomId.size() <= 128 &&
        data is map &&
        data.size() == 4 &&
        data.keys().hasAll(['ownerUid', 'memberUids', 'updatedAt', 'snapshot']) &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        m is list && m.size() >= 1 && m.size() <= 10 &&
        (m[0] is string && m[0].size() > 0 && m[0].size() <= 128) &&
        (m.size() < 2 || (m[1] is string && m[1].size() > 0 && m[1].size() <= 128)) &&
        (m.size() < 3 || (m[2] is string && m[2].size() > 0 && m[2].size() <= 128)) &&
        (m.size() < 4 || (m[3] is string && m[3].size() > 0 && m[3].size() <= 128)) &&
        (m.size() < 5 || (m[4] is string && m[4].size() > 0 && m[4].size() <= 128)) &&
        (m.size() < 6 || (m[5] is string && m[5].size() > 0 && m[5].size() <= 128)) &&
        (m.size() < 7 || (m[6] is string && m[6].size() > 0 && m[6].size() <= 128)) &&
        (m.size() < 8 || (m[7] is string && m[7].size() > 0 && m[7].size() <= 128)) &&
        (m.size() < 9 || (m[8] is string && m[8].size() > 0 && m[8].size() <= 128)) &&
        (m.size() < 10 || (m[9] is string && m[9].size() > 0 && m[9].size() <= 128)) &&
        data.ownerUid in m &&
        data.updatedAt is number && data.updatedAt >= 0 &&
        s is map &&
        s.size() == 14 &&
        s.keys().hasAll([
          'version', 'updatedAt', 'updatedByDeviceId', 'updatedByDeviceName',
          'likedTracks', 'likedTrackAddedAt', 'deletedLikedAt',
          'playlists', 'playlistUpdatedAt', 'deletedPlaylistsAt',
          'recentlyPlayed', 'recentlyPlayedAt', 'preferences', 'continueListening'
        ]) &&
        s.version is int && s.version == 1 &&
        s.updatedAt is number && s.updatedAt >= 0 &&
        s.updatedByDeviceId is string && s.updatedByDeviceId.size() <= 128 &&
        s.updatedByDeviceName is string && s.updatedByDeviceName.size() <= 128 &&
        s.likedTracks is list && s.likedTracks.size() <= 500 &&
        s.likedTrackAddedAt is map && s.likedTrackAddedAt.size() <= 600 &&
        s.deletedLikedAt is map && s.deletedLikedAt.size() <= 500 &&
        s.playlists is list && s.playlists.size() <= 100 &&
        s.playlistUpdatedAt is map && s.playlistUpdatedAt.size() <= 150 &&
        s.deletedPlaylistsAt is map && s.deletedPlaylistsAt.size() <= 500 &&
        s.recentlyPlayed is list && s.recentlyPlayed.size() <= 25 &&
        s.recentlyPlayedAt is map && s.recentlyPlayedAt.size() <= 50 &&
        p is map &&
        p.size() == 3 &&
        p.keys().hasAll(['theme', 'atmosPreset', 'updatedAt']) &&
        p.theme is string && p.theme in ['dark', 'light', 'glass'] &&
        p.atmosPreset is string && p.atmosPreset in ['music', 'movie', 'bass', 'off'] &&
        p.updatedAt is number && p.updatedAt >= 0 &&
        (cl == null || (
          cl is map &&
          cl.size() == 7 &&
          cl.keys().hasAll([
            'track', 'position', 'duration', 'isPlaying',
            'deviceId', 'deviceName', 'updatedAt'
          ]) &&
          (cl.track == null || isValidTrack(cl.track)) &&
          cl.position is number && cl.position >= 0 &&
          cl.duration is number && cl.duration >= 0 &&
          cl.isPlaying is bool &&
          cl.deviceId is string && cl.deviceId.size() <= 128 &&
          cl.deviceName is string && cl.deviceName.size() <= 128 &&
          cl.updatedAt is number && cl.updatedAt >= 0
        ));
    }

    function isValidDevicePresence(data, deviceId, roomId) {
      return deviceId is string && deviceId.size() > 0 && deviceId.size() <= 128 &&
        data is map &&
        data.keys().hasOnly([
          'deviceId', 'deviceName', 'platform', 'appVersion',
          'ownerUid', 'nowPlaying', 'lastSeenAt'
        ]) &&
        data.keys().hasAll([
          'deviceId', 'deviceName', 'platform', 'appVersion',
          'ownerUid', 'lastSeenAt'
        ]) &&
        data.deviceId is string && data.deviceId == deviceId &&
        data.deviceName is string && data.deviceName.size() <= 128 &&
        data.platform is string && data.platform in ['desktop', 'tv', 'mobile'] &&
        data.appVersion is string && data.appVersion.size() <= 64 &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.ownerUid in get(/databases/$(database)/documents/syncRooms/$(roomId)).data.memberUids &&
        (!('nowPlaying' in data) || data.nowPlaying == null || (
          data.nowPlaying is map &&
          data.nowPlaying.keys().hasAll(['title', 'artist', 'isPlaying', 'position', 'duration']) &&
          data.nowPlaying.keys().hasOnly(['title', 'artist', 'artwork', 'trackId', 'isPlaying', 'position', 'duration']) &&
          data.nowPlaying.title is string && data.nowPlaying.title.size() <= 500 &&
          data.nowPlaying.artist is string && data.nowPlaying.artist.size() <= 500 &&
          (!('artwork' in data.nowPlaying) || data.nowPlaying.artwork == null || (data.nowPlaying.artwork is string && data.nowPlaying.artwork.size() <= 32768)) &&
          (!('trackId' in data.nowPlaying) || data.nowPlaying.trackId == null || (data.nowPlaying.trackId is string && data.nowPlaying.trackId.size() <= 512)) &&
          data.nowPlaying.isPlaying is bool &&
          data.nowPlaying.position is number && data.nowPlaying.position >= 0 &&
          data.nowPlaying.duration is number && data.nowPlaying.duration >= 0
        )) &&
        data.lastSeenAt is number && data.lastSeenAt >= 0;
    }

    function isValidCommand(data) {
      return data is map &&
        data.keys().hasOnly([
          'targetDeviceId', 'action', 'fromDeviceId', 'fromDeviceName',
          'track', 'queue', 'position', 'volume', 'muted', 'atmosPreset', 'timestamp'
        ]) &&
        data.keys().hasAll([
          'targetDeviceId', 'action', 'fromDeviceId', 'fromDeviceName', 'timestamp'
        ]) &&
        data.targetDeviceId is string && data.targetDeviceId.size() > 0 && data.targetDeviceId.size() <= 128 &&
        data.action is string &&
        data.action in [
          'play_track', 'play', 'pause', 'toggle', 'next',
          'prev', 'seek', 'set_volume', 'set_atmos', 'sync_now'
        ] &&
        data.fromDeviceId is string && data.fromDeviceId.size() > 0 && data.fromDeviceId.size() <= 128 &&
        data.fromDeviceName is string && data.fromDeviceName.size() <= 128 &&
        (!('track' in data) || data.track == null || isValidTrack(data.track)) &&
        (!('queue' in data) || data.queue == null || (data.queue is list && data.queue.size() <= 100)) &&
        (!('position' in data) || data.position == null || (data.position is number && data.position >= 0)) &&
        (!('volume' in data) || data.volume == null || (data.volume is number && data.volume >= 0 && data.volume <= 100)) &&
        (!('muted' in data) || data.muted == null || data.muted is bool) &&
        (!('atmosPreset' in data) || data.atmosPreset == null || (data.atmosPreset is string && data.atmosPreset in ['music', 'movie', 'bass', 'off'])) &&
        data.timestamp is number && data.timestamp >= 0;
    }

    function isValidTvPairCodeCreate(data, code) {
      return code.matches('^[0-9]{6}$') &&
        data is map &&
        data.keys().hasOnly([
          'code', 'tvUid', 'tvDeviceId', 'tvDeviceName', 'status',
          'roomId', 'linkedByUid', 'linkedByEmail', 'linkedAt',
          'createdAt', 'expiresAt'
        ]) &&
        data.keys().hasAll([
          'code', 'tvUid', 'tvDeviceId', 'tvDeviceName', 'status',
          'roomId', 'linkedByUid', 'createdAt', 'expiresAt'
        ]) &&
        data.code is string && data.code == code &&
        data.tvUid is string && data.tvUid.size() > 0 && data.tvUid.size() <= 128 &&
        data.tvUid == request.auth.uid &&
        data.tvDeviceId is string && data.tvDeviceId.size() > 0 && data.tvDeviceId.size() <= 128 &&
        data.tvDeviceName is string && data.tvDeviceName.size() <= 128 &&
        data.status == 'waiting' &&
        data.roomId == null &&
        data.linkedByUid == null &&
        (!('linkedByEmail' in data) || data.linkedByEmail == null) &&
        (!('linkedAt' in data) || data.linkedAt == null) &&
        data.createdAt is number && data.createdAt >= 0 &&
        data.expiresAt is number &&
        data.expiresAt > data.createdAt;
    }

    function isValidTvPairCodeUpdate(newData, oldData, code) {
      return code.matches('^[0-9]{6}$') &&
        newData is map &&
        newData.keys().hasOnly([
          'code', 'tvUid', 'tvDeviceId', 'tvDeviceName', 'status',
          'roomId', 'linkedByUid', 'linkedByEmail', 'linkedAt',
          'createdAt', 'expiresAt'
        ]) &&
        newData.keys().hasAll([
          'code', 'tvUid', 'tvDeviceId', 'tvDeviceName', 'status',
          'roomId', 'linkedByUid', 'createdAt', 'expiresAt'
        ]) &&
        oldData.status == 'waiting' &&
        newData.status == 'linked' &&
        newData.code is string && newData.code == code && newData.code == oldData.code &&
        newData.tvUid is string && newData.tvUid.size() > 0 && newData.tvUid.size() <= 128 && newData.tvUid == oldData.tvUid &&
        newData.tvDeviceId is string && newData.tvDeviceId.size() > 0 && newData.tvDeviceId.size() <= 128 && newData.tvDeviceId == oldData.tvDeviceId &&
        newData.tvDeviceName is string && newData.tvDeviceName.size() <= 128 && newData.tvDeviceName == oldData.tvDeviceName &&
        newData.createdAt is number && newData.createdAt >= 0 && newData.createdAt == oldData.createdAt &&
        newData.expiresAt is number && newData.expiresAt > newData.createdAt && newData.expiresAt == oldData.expiresAt &&
        newData.linkedByUid == request.auth.uid &&
        newData.roomId is string && newData.roomId.size() > 0 && newData.roomId.size() <= 128 &&
        (!('linkedByEmail' in newData) || newData.linkedByEmail == null || (
          newData.linkedByEmail is string &&
          newData.linkedByEmail.size() <= 320 &&
          (newData.linkedByEmail.size() == 0 || newData.linkedByEmail.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"))
        )) &&
        (!('linkedAt' in newData) || newData.linkedAt == null || (newData.linkedAt is number && newData.linkedAt >= 0)) &&
        newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'roomId', 'linkedByUid', 'linkedByEmail', 'linkedAt'
        ]);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Private per-user profile document.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        uidUnchanged() &&
        isValidUser(request.resource.data, uid);
      allow update: if isOwner(uid) &&
        resource != null &&
        uidNotModified() &&
        isValidUser(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }

    // Shared household sync rooms across Desktop, Mobile, and TV.
    match /syncRooms/{roomId} {
      // Allow get when probing own personal room before initial creation, or when
      // the existing room is owned by / includes the authenticated user.
      allow get: if isAuthenticated() && (
        (resource == null && roomId == request.auth.uid) ||
        (resource != null &&
          (request.auth.uid == resource.data.ownerUid ||
           request.auth.uid in resource.data.memberUids))
      );

      // List queries only match existing rooms where the user is owner or member.
      allow list: if isAuthenticated() &&
        (request.auth.uid == resource.data.ownerUid ||
         request.auth.uid in resource.data.memberUids);

      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids &&
        isValidSyncRoom(request.resource.data, roomId);

      allow update: if isAuthenticated() &&
        resource != null &&
        request.auth.uid in resource.data.memberUids &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (request.auth.uid == resource.data.ownerUid ||
         request.resource.data.memberUids == resource.data.memberUids) &&
        isValidSyncRoom(request.resource.data, roomId);

      allow delete: if isAuthenticated() &&
        resource != null &&
        request.auth.uid == resource.data.ownerUid;

      // Live device presence within an authorized room.
      match /devices/{deviceId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) &&
          isValidDevicePresence(request.resource.data, deviceId, roomId);
        allow update: if isRoomMember(roomId) &&
          isValidDevicePresence(request.resource.data, deviceId, roomId);
        allow delete: if isRoomMember(roomId);
      }

      // Immutable cloud remote Cast commands within an authorized room.
      match /commands/{cmdId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) &&
          isValidCommand(request.resource.data);
        allow update: if false;
        allow delete: if isRoomMember(roomId);
      }
    }

    // Ephemeral 6-digit TV pairing handshake codes.
    match /tvPairCodes/{code} {
      allow list: if false;
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isValidTvPairCodeCreate(request.resource.data, code);
      allow update: if isAuthenticated() &&
        resource != null &&
        isValidTvPairCodeUpdate(request.resource.data, resource.data, code);
      allow delete: if isAuthenticated() &&
        resource != null &&
        (('tvUid' in resource.data && resource.data.tvUid == request.auth.uid) ||
         ('linkedByUid' in resource.data && resource.data.linkedByUid == request.auth.uid));
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
